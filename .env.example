# ==============================================================================
# FEAGLE WxBot 全栈生态统一配置中心 (.env)
# ==============================================================================
# 复制本文件为 .env: cp .env.example .env
# 严禁将含有真实秘钥的 .env 文件提交至公开代码仓库！
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础运行与时区配置
# ------------------------------------------------------------------------------
TZ=Asia/Shanghai
BOT_TIMEZONE=Asia/Shanghai
# 静音时段（在此期间不进行主动回复，格式 HH:MM-HH:MM）
BOT_QUIET_HOURS=00:00-07:00

# ------------------------------------------------------------------------------
# 2. 核心大脑形态选择（按需二选一，绝对解耦）
# ------------------------------------------------------------------------------
# 支持形态:
#   hermes  - Hermes 深度自主思考智能体（含长期记忆与技能扩展，自适应控制台开启画像/记忆）
#   astrbot - AstrBot 丰富社群插件平台（含小游戏/群管/插件市场，控制台自适应内嵌 6185）
BOT_BACKEND=hermes

# ------------------------------------------------------------------------------
# 3. 端口与网络绑定
# ------------------------------------------------------------------------------
# Bridge 控制台外部访问端口
DASHBOARD_HOST_PORT=6190

# Android 移动端 WebSocket 接入端口与路径
# 公网直接开放或经由反向代理接入（无需挂载 VPN）
ANDROID_WS_BIND_HOST=0.0.0.0
ANDROID_WS_HOST_PORT=6191
ANDROID_WS_PORT=6191
ANDROID_WS_PATH=/android

# AstrBot Web 管理后台端口（仅当 BOT_BACKEND=astrbot 时生效）
ASTRBOT_WEBUI_HOST_PORT=6185

# OneBot v11 通信反向 WS 地址（连接下游 Hermes 或 AstrBot）
# 若使用本地 Hermes，默认监听 6199 端口
ONEBOT_WS_URL=ws://127.0.0.1:6199/ws

# ------------------------------------------------------------------------------
# 4. 移动设备与平板安全配对 (SM-X200 / Android Hook)
# ------------------------------------------------------------------------------
# 平板端连接安全 Token（至少 32 位随机字符串，可由 install.sh 自动生成）
ANDROID_BRIDGE_TOKEN=replace_with_a_secure_random_token_32_chars_min

# 配对数据库与设备标识
ANDROID_PAIRING_DB_PATH=/app/data/android/pairing.sqlite
ANDROID_DEVICE_ID=

# 心跳保活与超时配置 (毫秒)
ANDROID_HEARTBEAT_TIMEOUT_MS=75000
ANDROID_COMMAND_TIMEOUT_MS=30000

# 联系人与群聊静默同步间隔 (默认 30 分钟 = 1800000 毫秒)
ANDROID_CONTACTS_SYNC_INTERVAL_MS=1800000
ANDROID_CONTACTS_SYNC_TIMEOUT_MS=25000

# ------------------------------------------------------------------------------
# 5. 大语言模型 (LLM) 凭证配置
# ------------------------------------------------------------------------------
# 启用 LLM 链路
LLM_ENABLED=true
# 提供商类型: deepseek / openai / custom
LLM_PROVIDER=custom
# API 基础地址（支持各类中转、官方端点或本地反代）
LLM_API_BASE=https://api.feagle.top/v1
# 默认主控模型名称（如 gemini-3.8-flash-high, deepseek-chat 等）
LLM_MODEL=gemini-3.8-flash-high
# 模型 API Key
LLM_API_KEY=replace_with_your_llm_api_key
# 最大上下文 Token 窗口（针对 1M 模型建议设置为 1048576，默认 131072）
LLM_MAX_CONTEXT_TOKENS=1048576

# ------------------------------------------------------------------------------
# 6. 国内网络下载与镜像加速源（自动测速脚本可动态配置）
# ------------------------------------------------------------------------------
NODE_IMAGE=node:22-alpine
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
NPM_REGISTRY=https://registry.npmmirror.com
PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ASTRBOT_GITHUB_PROXY=https://ghfast.top/

# ------------------------------------------------------------------------------
# 7. 微信消息流控与防封安全护栏 (Message Guard & Anti-Ban)
# ------------------------------------------------------------------------------
BOT_MAX_MESSAGE_CHARS=2000
BOT_MAX_MESSAGE_AGE_MS=600000
BOT_DUPLICATE_TTL_MS=300000
BOT_USER_RATE_LIMIT=3
BOT_USER_RATE_WINDOW_MS=30000
BOT_GLOBAL_RATE_LIMIT=30
BOT_GLOBAL_RATE_WINDOW_MS=60000
BOT_MAX_INFLIGHT=3
BOT_MAX_INFLIGHT_PER_USER=1
BOT_GROUP_REPLY_COOLDOWN_MS=5000
BOT_MAX_GROUP_REPLY_CHARS=1000
BOT_GROUP_JITTER_MIN_MS=1000
BOT_GROUP_JITTER_MAX_MS=3000
BOT_GROUP_MEMBER_RATE_LIMIT=3
BOT_GROUP_MEMBER_RATE_WINDOW_MS=60000
BOT_GROUP_RATE_LIMIT=6
BOT_GROUP_RATE_WINDOW_MS=60000
BOT_GROUP_FUSE_FAILURES=3
BOT_GROUP_FUSE_FAILURE_WINDOW_MS=300000
BOT_GROUP_FUSE_ANOMALIES=12
BOT_GROUP_FUSE_ANOMALY_WINDOW_MS=60000
BOT_GROUP_FUSE_DURATION_MS=900000

# ------------------------------------------------------------------------------
# 8. 可选飞书运维告警通知 (Feishu Notifier)
# ------------------------------------------------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
