# FEAGLE WxBot Bridge
# Copy this file to .env. Never commit the resulting .env file.

# General
TZ=Asia/Shanghai
BOT_TIMEZONE=Asia/Shanghai
BOT_QUIET_HOURS=00:00-07:00

# Dashboard and AstrBot WebUI are bound to localhost by Docker Compose.
DASHBOARD_HOST_PORT=6190
ASTRBOT_WEBUI_HOST_PORT=6185

# LLM provider
# Supported by the setup wizard:
#   deepseek: tested default
#   openai:   OpenAI-compatible custom endpoint
#   disabled: configure a provider later in AstrBot WebUI
LLM_ENABLED=true
LLM_PROVIDER=deepseek
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=replace-me
LLM_MAX_CONTEXT_TOKENS=131072

# Optional Feishu private-message notifications.
# Leave blank to disable. After publishing the Feishu app, privately message
# the bot with "绑定" to bind your open_id.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# OneBot reverse WebSocket stays inside the container.
ONEBOT_WS_URL=ws://127.0.0.1:6199/ws

# Message guard
BOT_MAX_MESSAGE_CHARS=2000
BOT_DUPLICATE_TTL_MS=300000
BOT_USER_RATE_LIMIT=3
BOT_USER_RATE_WINDOW_MS=30000
BOT_GLOBAL_RATE_LIMIT=30
BOT_GLOBAL_RATE_WINDOW_MS=60000
BOT_MAX_INFLIGHT=3
BOT_MAX_INFLIGHT_PER_USER=1

# Wechat4u health and recovery
WECHAT_QR_TTL_MS=120000
WECHAT_WATCHDOG_INTERVAL_MS=15000
WECHAT_STARTUP_GRACE_MS=90000
WECHAT_SYNC_DEGRADED_MS=90000
WECHAT_SYNC_RECOVER_MS=180000
WECHAT_RECOVERY_TIMEOUT_MS=75000
WECHAT_RECOVERY_BASE_DELAY_MS=15000
WECHAT_MAX_RECOVERY_FAILURES=3
WECHAT_FATAL_AFTER_MS=600000
