# ==============================================================================
# Hermes Agent 核心配置文件模板 (config.yaml.template)
# ==============================================================================

model:
  default: ${LLM_MODEL:-gemini-3.8-flash-high}
  provider: ${LLM_PROVIDER:-custom}
  base_url: ${LLM_API_BASE:-https://api.feagle.top/v1}
  api_key: "${LLM_API_KEY}"
  context_length: ${LLM_MAX_CONTEXT_TOKENS:-1048576}
  aliases:
    flash: custom/${LLM_MODEL:-gemini-3.8-flash-high}
    pro: custom/${LLM_MODEL:-gemini-3.8-flash-high}
  default_headers:
    User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36
  extra_headers:
    User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36

database:
  journal_mode: wal

agent:
  max_turns: 150
  verbose: false
  reasoning_effort: medium

platforms:
  onebot:
    enabled: true
    extra:
      host: 0.0.0.0
      port: 6199
      dm_policy: open
      group_policy: open

plugins:
  enabled:
    - onebot-platform
  disabled: []
